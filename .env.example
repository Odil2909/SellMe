DATABASE_URL=postgresql://uyol:uyol@localhost:5433/uyol
# For a hosted database use its PostgreSQL connection URL here.
# Set COOKIE_SECURE=true when Java API is served through HTTPS.
# Set LOG_STACKTRACE=true to include detailed Java error logs while debugging.

# Technical support AI (server-side only; never expose these values in the browser).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Telegram bot that receives support tickets and relays operator replies.
SUPPORT_TELEGRAM_BOT_TOKEN=
SUPPORT_TELEGRAM_OPERATOR_CHAT_ID=
# Telegram numeric user ID allowed to use the Mini App (private chat ID works for a 1:1 operator chat).
SUPPORT_TELEGRAM_OPERATOR_USER_ID=
# Public HTTPS URL to the deployed panel page, for example https://example.com/pages/operator-support.html
SUPPORT_TELEGRAM_WEBAPP_URL=
